# segredos NUNCA entram no repositorio
.env
.env.*
!.env.example
*.local

# ferramentas
node_modules/
.DS_Store
Thumbs.db
.vercel
.env*.local

# temporarios de teste (scripts e screenshots de verificacao)
.tmp-check/

# scripts descartaveis de edicao na RAIZ do projeto (nunca versionar)
# o padrao com / na frente so vale para a raiz: PDFs/ e scripts/ continuam versionados
/fix_*.py
/add_kit*.py
/remove_old_kit*.py
/upload_*.py
/debug_*.py
/_tmp_*
/tmp_*

# backup local feito antes das melhorias de seguranca (nao versionar)
BACKUP-*/

# fotos e catalogos em PDF: nao versionados (o site puxa as fotos do R2)
PDFs/img/
PDFs/*.pdf
