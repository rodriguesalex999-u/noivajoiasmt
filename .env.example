# ============================================================
# Copie este arquivo para .env.local  e preencha com os valores reais.
# NUNCA comite o .env.local  (o .gitignore ja protege).
#
# Onde pegar cada valor:
#   Mercado Pago -> Painel do desenvolvedor
#                  https://www.mercadopago.com.br/developers/panel
#                  Sua aplicacao -> Credenciais de producao
#   Melhor Envios -> a chave completa esta no .env da integracao:
#                  C:\Users\rodri\VIDA_GERAL_SHARED\VIDA_GERAL_ALEX_LEVE\melhor_envio\.env
# ============================================================

# Dominio do site published (tem que ser o mesmo das credenciais MP)
SITE_URL=https://noivajoiasmt.vercel.app

# ---------- Mercado Pago ----------
# Token de acesso da aplicacao (Checkout Pro / API de Preferences)
MP_ACCESS_TOKEN=
# Segredo do cliente, usado para validar a assinatura do webhook
MP_SECRET=

# ---------- Melhor Envios ----------
# Chave JWT da integracao (29 escopos, valida ate 23/09/2027)
ME_API_TOKEN=

# Remetente fixo: e de onde a etiqueta sai. Precisa ter CEP e CPF,
# porque a Melhor Envios exige os dois.
ME_SENDER_NAME=Noiva Joias MT
ME_SENDER_EMAIL=rodriguesalex999@gmail.com
ME_SENDER_CPF=
ME_SENDER_CEP=
ME_SENDER_STREET=
ME_SENDER_NUMBER=
ME_SENDER_DISTRICT=
ME_SENDER_CITY=
ME_SENDER_UF=MT