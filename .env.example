# ============================================================
# Copie este arquivo para .env.local  e preencha com os valores reais.
# NUNCA comite o .env.local  (o .gitignore ja protege).
#
# Onde pegar cada valor:
#   Mercado Pago -> Painel do desenvolvedor
#                  https://www.mercadopago.com.br/developers/panel
#                  Sua aplicacao -> Credenciais de producao
#   Melhor Envios -> a chave completa esta no .env da integracao:
#                  C:\Users\rodri\OneDrive\Documents\00-VIDA-ALEX\melhor_envio\.env
#   Token do dono -> ver o .env.local que ja existe nesta maquina
# ============================================================

# Dominio do site published (tem que ser o mesmo das credenciais MP)
SITE_URL=https://noivajoiasmt.vercel.app

# ---------- Mercado Pago ----------
# Token de acesso da aplicacao (Checkout Pro / API de Preferences)
MP_ACCESS_TOKEN=
# Segredo do cliente, usado para validar a assinatura do webhook
MP_SECRET=

# ---------- Melhor Envios ----------
# Chave JWT da integracao (29 escopos, valida ate 23/09/2027)
ME_API_TOKEN=

# Remetente fixo: e de onde a etiqueta sai. Precisa ter CEP e CPF,
# porque a Melhor Envios exige os dois.
# O CPF e o do titular da conta (Alex Rodrigues) — nao publicar.
ME_SENDER_NAME=Noiva Joias MT
ME_SENDER_EMAIL=rodriguesalex999@gmail.com
ME_SENDER_PHONE=65992771501
ME_SENDER_CPF=
ME_SENDER_CEP=78015140
ME_SENDER_STREET=Rua Santa Terezinha
ME_SENDER_NUMBER=31
ME_SENDER_DISTRICT=Dom Aquino
ME_SENDER_CITY=Cuiaba
ME_SENDER_UF=MT

# ---------- Acesso do dono ----------
# Token das acoes privadas (listar pedidos, cotar, gerar etiqueta).
# Vai no cabecalho "x-owner-token" da chamada.
OWNER_TOKEN=

# ============ ATENCAO: FORMATOS DA API MELHOR ENVIOS ============
# Dinheiro: REAL. A API devolve 38.94 = R$ 38,94 (Nao dividir por 100).
# Peso do volume: QUILOGRAMA (0.5 = 500 g).
# Medidas do volume: CENTIMETRO, de 1 a 300. Mandar 0,5 nas tres
#   dimensoes e recusado com HTTP 422.
# Numero do endereco: campo "number" (o "location_number" e ignorado).
# ================================================================
