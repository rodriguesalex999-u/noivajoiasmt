# ============================================================
# Copie este arquivo para .env.local  e preencha com os valores reais.
# NUNCA comite o .env.local  (o .gitignore ja protege).
#
# Onde pegar cada valor:
#   Mercado Pago -> Painel do desenvolvedor
#                  https://www.mercadopago.com.br/developers/panel
#                  Sua aplicacao -> Credenciais de producao
# ============================================================

# Dominio do site published (tem que ser o mesmo das credenciais MP)
SITE_URL=https://noivajoiasmt.vercel.app

# Token de acesso da aplicacao (Checkout Pro / API de Preferences)
MP_ACCESS_TOKEN=

# Segredo do cliente, usado para validar a assinatura do webhook
MP_SECRET=